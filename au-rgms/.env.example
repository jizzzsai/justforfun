# ── AU Grant Assistant (Google Gemini · free tier) ─────────────
# 1) Get a free API key:  https://aistudio.google.com/apikey
# 2) Add it in Vercel:    Project "au-rgms" → Settings → Environment Variables
#    (Name: GEMINI_API_KEY, paste the key as the value), then redeploy.
GEMINI_API_KEY=

# Optional — override the model (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash
